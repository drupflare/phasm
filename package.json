{
	"name": "@drupflare/phasm",
	"version": "0.1.0",
	"private": true,
	"description": "Tooling only. The published artifacts are the wasm builds attached to GitHub Releases.",
	"scripts": {
		"format:c": "clang-format --style=file -i src/probes/*.c",
		"inspect": "bash src/inspect-build.sh",
		"lint": "bash tools/lint-shell.sh",
		"lint:c": "clang-format --style=file --dry-run --Werror src/probes/*.c",
		"lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\"",
		"lint:rc": "bash tools/lint-rc.sh",
		"lint:shellcheck": "find src tools -name '*.sh' -print0 | xargs -0 shellcheck -x",
		"prepare": "husky",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"test": "bash tools/test-patch-verify.sh"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.6",
		"prettier-plugin-sh": "^0.19.0"
	},
	"lint-staged": {
		"*.{md,json,yml}": "prettier --write",
		"*.sh": [
			"prettier --write",
			"bash tools/lint-shell.sh",
			"shellcheck -x"
		],
		"*.{c,h,cpp,hpp,cc}": [
			"clang-format --style=file -i",
			"bash tools/lint-shell.sh"
		],
		"*.rc": "bash tools/lint-shell.sh"
	}
}
