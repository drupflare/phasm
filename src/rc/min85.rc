# The FLOOR: PHP 8.5 with only what Drupal cannot render without.
#
# ext-dom is required on the anonymous render path -- the filter module's
# FilterHtml/FilterAlign/FilterCaption all reach Html::load(), which calls
# DOMDocument::loadHTML(), libxml2's parser. So dom plus libxml2 stay, and vrzno
# stays because it is the PHP-to-JS bridge every Host:: call goes through.
#
# Everything else is off, including opcache, session, filter and tokenizer. This
# is NOT a shippable configuration; it exists to measure how much of the 3,145,728
# ceiling is left once the unavoidable extensions are in, which bounds the search
# every other variant is negotiating inside.
PHP_VERSION=8.5

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=0
WITH_XML=0
WITH_YAML=0
WITH_ZLIB=0

WITH_CTYPE=0
WITH_FILTER=0
WITH_SESSION=0
WITH_TOKENIZER=0

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache
