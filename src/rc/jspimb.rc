# mbstring.rc plus JSPI. Built on the tree that was already configured
# --enable-mbstring --disable-mbregex, so it carries the real mbstring fix too;
# the php-wasm `configured` stamp is a plain file target, so a differing
# CONFIGURE_FLAGS in an rc is SILENTLY IGNORED once that stamp exists. Matching
# the tree's own config.nice is therefore mandatory, not cosmetic.
#
# JSPI is a LINK-only setting. emcc.py:303 aliases `-sJSPI=1` to ASYNCIFY=2, and
# EXTRA_FLAGS lands after `-s ASYNCIFY=${ASYNCIFY}` in EXTRA_LDFLAGS_PROGRAM
# (Makefile:426), so the ASYNCIFY=0 above is overridden on purpose - do not
# "fix" it. The glue then wraps every JSPI_EXPORTS name with
# WebAssembly.promising and every async import with WebAssembly.Suspending
# (library_async.js:58/117), which is the same raw API assets/jspi/park.wasm
# proved workerd honours across an invocation boundary.
#
# JSPI_IMPORTS is deliberately NOT set: emcc.py:306 makes it REPLACE the default
# ASYNCIFY_IMPORTS list rather than extend it. EM_ASYNC_JS marks its own import
# async via the __asyncjs__ prefix, so nothing has to be listed.
#
# pib_tokenize is left out of JSPI_EXPORTS: PhpBase.mjs:236 calls it with a STR
# return and no {async:true}, and a promising export would hand UTF8ToString a
# Promise.

PHP_VERSION=8.3

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

CONFIGURE_FLAGS+= --enable-opcache
CONFIGURE_FLAGS+= --enable-mbstring --disable-mbregex

EXTRA_FLAGS+= -s JSPI=1
EXTRA_FLAGS+= -s JSPI_EXPORTS=main,pib_init,pib_storage_init,pib_run,pib_exec,pib_refresh
