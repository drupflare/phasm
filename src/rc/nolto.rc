# control.rc with LTO removed. php-wasm sets LTO_FLAG?=-flto at Makefile line
# 140 and feeds it to EXTRA_CFLAGS (404), EXTRA_CXXFLAGS (405) and
# EXTRA_LDFLAGS_PROGRAM (408), so every build in vendor/ already has LTO.
#
# LTO_FLAG carries -O2 here rather than being empty. -O${OPTIMIZE} reaches only
# the LINK flags, so LTO_FLAG is the only optimization in the compile half:
# emptying it compiles at -O0 and a function then exceeds Binaryen's
# per-function locals cap, failing wasm-emscripten-finalize with
# "parse exception: too many locals". Substituting -O2 holds the optimization
# level constant and removes only LTO, which is what the variant is for.

PHP_VERSION=8.3

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB
LTO_FLAG=-O2

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

CONFIGURE_FLAGS+= --enable-opcache
