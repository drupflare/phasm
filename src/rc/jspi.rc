# control.rc plus JSPI plus the VM interrupt patch. This is the shippable shape:
# NO mbstring, because mbstring measured +584,856 bytes gzipped on this tree
# (static-mbstring 3,342,549 vs static-o2 2,757,693 wasm gz) which puts the
# bundle over the 3 MB free ceiling on its own.
#
# JSPI is link-only: emcc.py:303 aliases -sJSPI=1 to ASYNCIFY=2, and EXTRA_FLAGS
# lands after `-s ASYNCIFY=${ASYNCIFY}` in EXTRA_LDFLAGS_PROGRAM (Makefile:426),
# so the ASYNCIFY=0 below is overridden deliberately.
#
# JSPI_IMPORTS is deliberately unset: emcc.py:306 makes it REPLACE the default
# ASYNCIFY_IMPORTS list rather than extend it, and EM_ASYNC_JS marks its own
# import async through the __asyncjs__ name prefix anyway.

PHP_VERSION=8.3

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache

EXTRA_FLAGS+= -s JSPI=1
EXTRA_FLAGS+= -s JSPI_EXPORTS=main,pib_init,pib_storage_init,pib_run,pib_exec,pib_refresh
