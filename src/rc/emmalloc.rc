# long64.rc with emmalloc instead of dlmalloc, and nothing else changed.
#
# THE ALLOCATOR HAS NEVER BEEN CHOSEN, ONLY DEFAULTED. No rc has ever passed a
# MALLOC setting, so every build in this repository has used emscripten's
# default dlmalloc by omission rather than by decision.
#
# THE INTERESTING QUESTION IS NOT SPEED. In this system heap size is four things
# at once: peak against the 128 MiB isolate cap, the number of grow events, the
# snapshot's kept-page count, and therefore restore bandwidth and stored rows per
# site. emmalloc's pitch is a smaller allocator with lower per-allocation
# overhead and worse fragmentation behaviour under some workloads -- so it could
# move all four, in either direction.
#
# SCORE IT ON PEAK HEAP FOR THE AUTHENTICATED RENDER, which is the binding
# workload, plus kept pages in a snapshot and grow count. NOT on a render's wall
# clock: a plain render reads 96.00 MiB on every arm measured so far and answers
# nothing, and RULE 0 forbids a local clock as a CPU figure anyway.
#
# WHAT WOULD MAKE IT A CLEAR WIN: a materially smaller steady-state live heap.
# What would make it a clear loss: a higher peak, because the consumer's margin
# is 19.50 MiB and a worse fragmentation profile spends it.
#
# MALLOC is compiled INTO the output rather than selected at link, so
# src/build-variant.sh passes it to both halves and stamps the ABI, or a tree
# built with dlmalloc would be silently relinked.

# MALLOC=emmalloc
# the shipping ABI, held constant so this arm has exactly one variable against what
# ships; without it the arm would silently be a wasm32 comparison
# ZEND_LONG64=1

PHP_VERSION=8.5

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache
