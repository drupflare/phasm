# control85.rc with the two extensions Drupal can live without, so the pair can be
# priced against control85 in the same run instead of across builds.
#
# WITH_YAML=0: Drupal's Yaml::decode() already falls back to Symfony's pure-PHP
# parser when yaml_parse() is absent, and Symfony ships in vendor. Measured, the
# PECL extension is 83,551 gzipped bytes and buys 241 ms of boot, which RULE 0b
# prices at about 1% of the regeneration ceiling.
#
# WITH_ZLIB=0: fflate is already a dependency of drupflare/worker and workerd has
# native CompressionStream, so gzencode/gzdecode/gzcompress are replaceable through
# the Host bridge, the same substitution mb-fix.js already makes. Measured, 43,485
# gzipped bytes. NOTE core's composer.json lists ext-zlib, so the bridge shim has
# to land before this ships; this variant exists to price it, not to deploy it.
PHP_VERSION=8.5

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=0
WITH_ZLIB=0

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache
