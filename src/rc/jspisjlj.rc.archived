# jspi.rc plus WASM SjLj. This is the variant that can actually suspend from
# inside PHP, if src/probes/sjlj-jspi-probe.c says so: emscripten's default SjLj
# rewrites every call made from a setjmp-containing function into an invoke_*
# JS trampoline (35 references in vendor/static-o2/php8.3-worker.mjs), and
# pib_run opens a zend_try before it calls the VM, so the default build has a JS
# frame between the promising export and the suspending import - exactly what
# JSPI refuses to suspend across.
#
# -sSUPPORT_LONGJMP=wasm routes longjmp through wasm exception handling instead,
# so no JS frame is introduced. It is needed at BOTH compile and link; the compile
# half cannot live in this file because Makefile:209 clears EXTRA_CFLAGS after the
# rc is included, so pass it as a make command-line variable:
#   MAKE_EXTRA='EXTRA_CFLAGS=-sSUPPORT_LONGJMP=wasm' OUT=... bash src/build-static.sh <src>

PHP_VERSION=8.3

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache

EXTRA_FLAGS+= -s JSPI=1
EXTRA_FLAGS+= -s JSPI_EXPORTS=main,pib_init,pib_storage_init,pib_run,pib_exec,pib_refresh

EXTRA_FLAGS+= -s SUPPORT_LONGJMP=wasm
