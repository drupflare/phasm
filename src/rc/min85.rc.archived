# control85.rc with every extension this project has PROVEN it can substitute or
# does not reach, so the pair prices the whole substitution programme in one run.
#
# Dropped: yaml (Symfony's pure-PHP parser is already in vendor), zlib (fflate is
# already a worker dependency and workerd has CompressionStream), simplexml and xml
# (neither is on the anonymous render path; libxml2 stays for dom regardless).
#
# KEPT, and this is the correction that cost a CI slot: session, filter, tokenizer
# and ctype stay. An earlier revision zeroed everything but vrzno/dom/libxml and the
# link failed with `undefined symbol: ps_globals` -- ext/session's globals are
# referenced unconditionally, so WITH_SESSION=0 does not link. All four are also in
# core's own composer.json requirement list, so a floor without them could never
# ship even if it linked.
#
# pdo is NOT dropped here: it needs the userland PDO-constants shim to land first,
# since core's sqlite Connection references PDO::FETCH_ASSOC and rom extends it.
PHP_VERSION=8.5

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=0
WITH_XML=0
WITH_YAML=0
WITH_ZLIB=0

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache
