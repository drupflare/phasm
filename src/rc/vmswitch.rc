# control.rc, built against a SWITCH-dispatch Zend VM instead of the shipped one.
#
# There is no configure flag for this: ZEND_VM_KIND is chosen in
# Zend/zend_vm_opcodes.h as HYBRID when (__GNUC__ && HAVE_GCC_GLOBAL_REGS) and
# CALL otherwise, and Zend/Zend.m4's global-register probe only knows i386,
# x86_64, powerpc64, aarch64 and riscv64, so wasm32 hits its #error and
# HAVE_GCC_GLOBAL_REGS is never defined. Every build in vendor/ is therefore
# ZEND_VM_KIND_CALL. SWITCH requires regenerating Zend/zend_vm_execute.h with
#   php Zend/zend_vm_gen.php --with-vm-kind=SWITCH
# which src/build-variant.sh does for a variant named vmswitch.

PHP_VERSION=8.3

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

CONFIGURE_FLAGS+= --enable-opcache
