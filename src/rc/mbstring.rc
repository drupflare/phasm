# control.rc plus the REAL mbstring extension. This is the fix for the
# mb_substr()-returns-'' data-loss bug; compiling iconv in is NOT (see
# iconv.rc for the refutation and its mechanism).
#
# php-wasm cannot express this: WITH_MBSTRING=static emits `--with-mbstring`,
# and ext/mbstring/config.m4 declares PHP_ARG_ENABLE([mbstring]) with no
# --with- form, so autoconf silently ignores it. That is why every earlier build
# reported mbstring absent despite WITH_MBSTRING=static in the rc. The working
# flag has to go through CONFIGURE_FLAGS directly.
#
# --disable-mbregex keeps oniguruma out: mb_substr / mb_strtolower / mb_strlen
# need libmbfl (bundled in ext/mbstring), not the regex engine, and Drupal core
# calls no mb_ereg_* function.

PHP_VERSION=8.3

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

CONFIGURE_FLAGS+= --enable-opcache
CONFIGURE_FLAGS+= --enable-mbstring --disable-mbregex
