# control85.rc plus LLVM's -mergefunc at LTO time, which targets the single largest mass in
# the binary at ZERO capability cost.
#
# THE INJECTION POINT, read off php-wasm rather than guessed. Makefile:140 declares
# `LTO_FLAG?=-flto`, so an rc can override it, and Makefile:406-408 interpolates ${LTO_FLAG}
# into EXTRA_LDFLAGS_PROGRAM -- which is the link this needs to reach. EXTRA_LDFLAGS_PROGRAM
# is assigned inside the recipe and cannot be set from here; LTO_FLAG can.
#
# THE CAVEAT this carries: Makefile:404-405 also interpolate ${LTO_FLAG} into EXTRA_CFLAGS and
# EXTRA_CXXFLAGS, so every compile receives the `-Wl,` form too and clang warns
# "argument unused during compilation" on each one. Harmless and loud. There is no rc-reachable
# variable that lands on the link alone.
PHP_VERSION=8.5

MAIN_MODULE=0
ASYNCIFY=0
OPTIMIZE=2
INITIAL_MEMORY=96MB

LTO_FLAG=-flto -Wl,-mllvm,-enable-merge-functions

WITH_VRZNO=1
WITH_LIBXML=static
WITH_DOM=static
WITH_SIMPLEXML=static
WITH_XML=static
WITH_YAML=static
WITH_ZLIB=static

WITH_CTYPE=1
WITH_FILTER=1
WITH_SESSION=1
WITH_TOKENIZER=1

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_EXIF=0

WITH_ICONV=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_SQLITE=0
WITH_GD=0
WITH_LIBPNG=0
WITH_LIBJPEG=0
WITH_FREETYPE=0
WITH_LIBWEBP=0
WITH_LIBZIP=0
WITH_PHAR=0
WITH_XMLREADER=0
WITH_XMLWRITER=0
WITH_INTL=0
WITH_TIDY=0
WITH_SDL=0
WITH_OPENSSL=0
WITH_PDO_PGLITE=0
WITH_PDO_CFD1=0
WITH_WAITLINE=0

# opcache is compiled in; file_cache_only is set at runtime from the worker ini
CONFIGURE_FLAGS+= --enable-opcache
